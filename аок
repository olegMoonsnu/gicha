import java.util.Base64
import java.util.logging.Logger


/**
 *
 *
 *
 * Отвечает за:
 *
 * 1. Проверку входящих файлов
 * 2. Подготовку файлов
 * 3. Прикрепление файлов к созданной заявке
 *
 *
 * Использование:
 *
 * Сначала:
 *
 * validateAttachments()
 *
 * Потом после создания serviceCall:
 *
 * attachFiles()
 *
 */
class NaumenAttachmentModule {


    private static final Logger logger =
            Logger.getLogger(
                    NaumenAttachmentModule.name
            )



    // Максимальное количество файлов
    private static final int MAX_FILES = 10


    // Максимальный размер одного файла
    private static final long MAX_FILE_SIZE =
            10 * 1024 * 1024



    // Максимальный общий размер файлов
    private static final long MAX_TOTAL_SIZE =
            50 * 1024 * 1024




    /**
     *
     * Проверяем файлы ДО создания заявки.
     *
     * Если хотя бы один файл плохой -
     * заявку создавать нельзя.
     *
     */
    Map validateAttachments(
            List attachments
    ){


        // Если файлов нет,
        // продолжаем обычное создание заявки

        if(!attachments){

            logger.info(
                    "Файлы отсутствуют"
            )


            return [
                    success:true,
                    files:[]
            ]

        }




        if(attachments.size() > MAX_FILES){


            return [
                    success:false,
                    message:
                    "Превышено количество файлов"
            ]

        }




        List preparedFiles = []

        long totalSize = 0




        attachments.each { attachment ->


            logger.info(
                    "Проверка файла: "
                    + attachment.fileName
            )



            Map result =
                    prepareFile(
                            attachment
                    )



            if(!result.success){

                return result

            }



            preparedFiles.add(
                    result.file
            )



            totalSize +=
                    result.file.size




            if(totalSize > MAX_TOTAL_SIZE){


                return [
                        success:false,
                        message:
                        "Общий размер файлов превышен"
                ]

            }


        }



        return [

                success:true,

                files:preparedFiles

        ]

    }






    /**
     *
     * Проверка одного файла.
     *
     * Base64 превращаем в byte[]
     *
     */
    private Map prepareFile(
            Map attachment
    ){


        if(!attachment.fileName){


            return [
                    success:false,
                    message:
                    "Не указано имя файла"
            ]

        }



        if(!attachment.contentBase64){


            return [
                    success:false,
                    message:
                    "Отсутствует содержимое файла "
                    + attachment.fileName
            ]

        }




        byte[] bytes



        try{


            bytes =
                    Base64.decoder.decode(
                            attachment.contentBase64
                    )


        }
        catch(Exception e){


            logger.info(
                    "Ошибка Base64 файла "
                    + attachment.fileName
            )


            return [

                    success:false,

                    message:
                    "Файл поврежден "
                    + attachment.fileName

            ]

        }





        if(bytes.length > MAX_FILE_SIZE){


            return [

                    success:false,

                    message:
                    "Файл слишком большой "
                    + attachment.fileName

            ]

        }





        return [

                success:true,


                file:[

                        fileName:
                                attachment.fileName,


                        contentType:
                                attachment.contentType,


                        size:
                                bytes.length,


                        bytes:
                                bytes

                ]

        ]


    }








    /**
     *
     * Этот метод вызываем ПОСЛЕ создания заявки.
     *
     * Передаем:
     *
     * files - подготовленные файлы
     *
     *
     *
     */
    List attachFiles(
            List files,
            String uuid
    ){


        List result = []



        files.each { file ->



            try{


                uploadFile(
                        file,
                        uuid
                )



                result << [

                        fileName:
                                file.fileName,


                        success:true

                ]



            }
            catch(Exception e){



                logger.info(
                        "Ошибка загрузки файла "
                        + file.fileName
                )



                result << [

                        fileName:
                                file.fileName,


                        success:false,

                        message:
                                e.message

                ]

            }


        }



        return result

    }








