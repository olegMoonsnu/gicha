     *
     * Отправка одного файла в Naumen.
     *
     * Используется REST метод:
     *
     * POST
     *
     * /services/rest/add-file/{UUID}
     *
     *
     * multipart:
     *
     * content = bytes файла
     *
     */
    private void uploadFile(
