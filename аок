import java.util.Base64
import java.util.logging.Logger

/**
 * Сервис работы с вложениями Naumen.
 *
 * Этапы работы:
 *
 * 1. validateAttachments()
 *    Проверяет входящие файлы до создания заявки.
 *
 * 2. createAttachments()
 *    После создания заявки создаёт объекты File
 *    и связывает их через source = UUID объекта.
 *
 */
class NaumenAttachmentService {

    private static final Logger logger =
            Logger.getLogger(
                    NaumenAttachmentService.name
            )

    private static final int MAX_FILES = 10
    private static final long MAX_FILE_SIZE = 10 * 1024 * 1024
    private static final long MAX_TOTAL_SIZE = 50 * 1024 * 1024


    /**
     * Проверяем файлы перед созданием serviceCall.
     *
     * Если хотя бы один файл плохой -
     * возвращаем ошибку и заявку не создаём.
     */
    Map validateAttachments(List attachments) {

        if (!attachments) {
            logger.info("Вложения отсутствуют")

            return [
                    success: true,
                    files: []
            ]
        }

        if (attachments.size() > MAX_FILES) {
            return [
                    success: false,
                    message: "Превышено количество файлов"
            ]
        }

        List preparedFiles = []
        long totalSize = 0

        for (Map attachment : attachments) {

            logger.info(
                    "Проверка файла: ${attachment.fileName}"
            )

            Map result = prepareFile(attachment)

            if (!result.success) {
                return result
            }

            preparedFiles.add(result.file)

            totalSize += result.file.size

            if (totalSize > MAX_TOTAL_SIZE) {
                return [
                        success: false,
                        message: "Общий размер файлов превышен"
                ]
            }
        }

        return [
                success: true,
                files: preparedFiles
        ]
    }


    /**
     * Проверка одного файла.
     *
     * Base64 -> byte[]
     */
    private Map prepareFile(Map attachment) {

        if (!attachment.fileName) {
            return [
                    success: false,
                    message: "Не указано имя файла"
            ]
        }

        if (!attachment.contentBase64) {
            return [
                    success: false,
                    message:
                            "Нет содержимого файла ${attachment.fileName}"
            ]
        }

        byte[] bytes

        try {
            bytes = Base64.decoder.decode(
                    attachment.contentBase64
            )
        } catch (Exception e) {

            logger.info(
                    "Ошибка Base64 файла ${attachment.fileName}"
            )

            return [
                    success: false,
                    message:
                            "Поврежден Base64 файла ${attachment.fileName}"
            ]
        }

        if (bytes.length > MAX_FILE_SIZE) {
            return [
                    success: false,
                    message:
                            "Файл слишком большой ${attachment.fileName}"
            ]
        }

        return [
                success: true,
                file: [
                        fileName: attachment.fileName,
                        contentType: attachment.contentType,
                        size: bytes.length,
                        bytes: bytes
                ]
        ]
    }


    /**
     * Создание файлов после создания заявки.
     *
     * sourceUuid:
     *
     * serviceCall$12345
     *
     */
    List createAttachments(
            List files,
            String sourceUuid
    ) {

        List result = []

        for (Map file : files) {

            try {

                def createdFile =
                        createFile(
                                file,
                                sourceUuid
                        )

                result.add([
                        fileName: file.fileName,
                        success: true,
                        uuid: createdFile.UUID
                ])

            } catch (Exception e) {

                logger.info(
                        "Ошибка создания файла ${file.fileName}"
                )

                result.add([
                        fileName: file.fileName,
                        success: false,
                        message: e.message
                ])
            }
        }

        return result
    }


    /**
     * Создание объекта File в Naumen.
     *
     * Здесь уже используется внутренний API Naumen.
     */
    private def createFile(
            Map file,
            String sourceUuid
    ) {

        /*
         * Здесь нужно использовать ваш механизм создания объектов:
         *
         * tools.create()
         * api.create()
         * metadata.create()
         *
         */

        def naumenFile = tools.create("File")

        naumenFile.name =
                file.fileName

        naumenFile.contentType =
                file.contentType

        naumenFile.content =
                file.bytes

        /*
         * Главная связь:
         *
         * файл принадлежит объекту
         */
        naumenFile.source =
                sourceUuid

        tools.save(
                naumenFile
        )

        logger.info(
                "Файл создан ${file.fileName}"
        )

        return naumenFile
    }
}